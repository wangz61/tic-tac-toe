{
  "name": "tic-tac-toe",
  "productName": "Tic-Tac-Toe",
  "private": true,
  "version": "1.1.0",
  "description": "A tic-tac-toe game with computer, two-player and online modes.",
  "author": "Zihao Wang",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable",
    "server": "python -m uvicorn server.app:app --host 0.0.0.0 --port 8000",
    "test:server": "python -m pytest server -q"
  },
  "build": {
    "appId": "local.tictactoe",
    "productName": "Tic-Tac-Toe",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "electron/icon.png",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "TicTacToe-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
